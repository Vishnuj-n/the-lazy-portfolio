{
  "name": "auto-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "fetch-data": "node scripts/fetch-projects.js",
    "verify-assets": "node scripts/verify-assets.js",
    "prepare-data": "npm run fetch-data && npm run verify-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/parse-issue.test.js tests/unit/templates.test.js tests/fetch-projects.test.js tests/validate-portfolio.test.js tests/verify-assets.test.js",
    "test:integration": "vitest run tests/integration/data-pipeline.test.js",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "parse:issue": "node scripts/parse-issue.js",
    "prebuild": "npm run prepare-data",
    "build": "vite build",
    "build:offline": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/syne": "^5.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
